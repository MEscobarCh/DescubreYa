{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/businesses",
      "dest": "server/index.ts"
    },
    {
      "src": "/api/tourism",
      "dest": "server/index.ts"
    },
    {
      "src": "/api/auth/(.*)",
      "dest": "server/index.ts"
    },
    {
      "src": "/api/favorites(.*)",
      "dest": "server/index.ts"
    },
    {
      "src": "/api/reviews(.*)",
      "dest": "server/index.ts"
    },
    {
      "src": "/api/upload-url",
      "dest": "server/index.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}